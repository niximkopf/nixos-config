#![enable(implicit_some)]
#![enable(unwrap_newtypes)]
#![enable(unwrap_variant_newtypes)]
(
    address: "127.0.0.1:6600",
    browser_song_sort: [Filename],
    volume_step: 5,
    scrolloff: 2,
    max_fps: 60,
    wrap_navigation: true,
    theme: "theme.ron",
    cache_dir: Some("/tmp/rmpc/cache"),
    lyrics_dir: "~/Music",
    status_update_interval_ms: 1000,
    enable_mouse: true,
    enable_config_hot_reload: true,
    album_art: (
        method: Auto,
        max_size_px: (width: 0, height: 0),
        vertical_align: Center,
        horizontal_align: Center,
    ),
    cava: (
        framerate: 60,
        autosens: true,
        sensitivity: 130,
        input: (
            method: Fifo,
            source: "/tmp/mpd.fifo",
            sample_rate: 44100,
            channels: 2,
            sample_bits: 16,
        ),
        smoothing: (
            noise_reduction: 20,
            monstercat: true,
            waves: false,
        ),
    ),
    keybinds: (
        global: {
            "~":       ShowHelp,
            "O":       ShowOutputs,
            "I":       ShowCurrentSongInfo,
            "<C-p>":   ShowDecoders,
            ":":       CommandMode,
            ".":       VolumeUp,
            ",":       VolumeDown,
            "p":       TogglePause,
            "s":       Stop,
            ">":       NextTrack,
            "<":       PreviousTrack,
            "<Right>": NextTab,
            "<Tab>":   NextTab,
            "<Left>":  PreviousTab,
            "<S-Tab>": PreviousTab,
            "1":       SwitchToTab("Queue"),
            "2":       SwitchToTab("Directories"),
            "3":       SwitchToTab("Playlists"),
            "4":       SwitchToTab("Search"),
            "z":       ToggleRepeat,
            "x":       ToggleRandom,
            "c":       ToggleSingle,
            "f":       SeekForward,
            "b":       SeekBack,
        },
        navigation: {
            "<S-Up>":      PaneUp,
            "<S-Down>":    PaneDown,
            "<S-Left>":    PaneLeft,
            "<S-Right>":   PaneRight,
            "<C-u>":       UpHalf,
            "N":           PreviousResult,
            "a":           Add,
            "A":           AddAllReplace,
            "r":           Rename,
            "n":           NextResult,
            "g":           Top,
            "<Space>":     Select,
            "G":           Bottom,
            "h":           Left,
            "<CR>":        Confirm,
            "i":           FocusInput,
            "J":           MoveDown,
            "j":           Down,
            "<C-d>":       DownHalf,
            "/":           EnterSearch,
            "<C-c>":       Close,
            "<Esc>":       Close,
            "K":           MoveUp,
            "l":           Right,
            "D":           Delete,
            "k":           Up,
            "B":           ShowInfo,
        },
        queue: {
            "D":           DeleteAll,
            "<CR>":        Play,
            "<C-s>":       Save,
            "a":           AddToPlaylist,
            "X":       Shuffle,
            "d":           Delete,
        },
    ),
    search: (
        case_sensitive: false,
        mode: Contains,
        tags: [
            (value: "any",         label: "Any Tag"),
            (value: "artist",      label: "Artist"),
            (value: "album",       label: "Album"),
            (value: "albumartist", label: "Album Artist"),
            (value: "title",       label: "Title"),
        ],
    ),
    tabs: [
        (
            name: "Queue",
            border_type: None,
            pane: Split(
                direction: Vertical,
                panes: [
                    (
                        size: "65%",
                        pane: Split(
                            direction: Horizontal,
                            panes: [
                                (
                                    size: "30%",
                                    borders: "LEFT | RIGHT | TOP | BOTTOM",
                                    border_symbols: Rounded,
                                    pane: Pane(AlbumArt)
                                ),
                                (
                                    size: "100%",
                                    borders: "LEFT | RIGHT | TOP | BOTTOM",
                                    border_symbols: Rounded,
                                    pane: Pane(Queue),
                                ),
                            ],
                        ),
                    ),
                    (
                        size: "35%",
                        pane: Split(
                            direction: Vertical,
                            panes: [
                                (
                                    size: "100",
                                    borders: "LEFT | RIGHT | TOP | BOTTOM",
                                    border_symbols: Rounded,
                                    pane: Pane(Cava)
                                ),
                            ],
                        ),
                    )
                ],
            ),
        ),
        (
            name: "Directories",
            border_type: None,
            pane: Pane(Directories),
        ),
        (
            name: "Playlists",
            border_type: None,
            pane: Pane(Playlists),
        ),
        (
            name: "Search",
            border_type: None,
            pane: Pane(Search),
        ),
    ],
)